<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="SAOStyles.uss" />
    <ui:VisualElement name="GameOverScreen" class="sao-root">
        <ui:VisualElement class="sao-card" style="border-color: #e74c3c;">
            <ui:Label text="DEAD" class="sao-title" style="font-size: 56px; color: #e74c3c;" />
            <ui:Label text="<< COMBAT TERMINATED >>" class="sao-subtitle" style="color: #ff7675;" />
            <ui:Label text="Final Score: 0" name="FinalScoreText" class="sao-label" />
            <ui:Label text="Wave Cleared: 0" name="FinalWaveText" class="sao-label" />
            <ui:Button text="RETRY" name="RetryButton" class="sao-button" style="border-color: #e74c3c; margin-top: 24px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
